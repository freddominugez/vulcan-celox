#!/bin/sh
# Verifica e instala, com a permissão do usuário, as bibliotecas de que o Vulcan Terminal precisa no Linux.
#
#   vulcan-terminal-deps              verifica, mostra o que falta e pergunta antes de instalar
#   vulcan-terminal-deps --verificar  só verifica (0 = tudo ok, 1 = falta algo)
#   vulcan-terminal-deps -y           instala o que falta sem perguntar (autorização dada na linha de comando)
#
# Códigos de saída: 0 ok ou instalado, 1 falta algo (--verificar), 2 gerenciador não suportado,
# 3 não autorizado ou sem como pedir permissão, 4 a instalação falhou.
set -u

MODE="ask"
for arg in "$@"; do
  case "$arg" in
    --verificar|--check) MODE="check" ;;
    -y|--sim|--yes) MODE="yes" ;;
    -h|--help|--ajuda) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "opção desconhecida: $arg (use --ajuda)" >&2; exit 2 ;;
  esac
done

have() { command -v "$1" >/dev/null 2>&1; }

python_ok() {
  have python3 && python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null
}
gtk_ok() {
  python_ok && python3 -c '
import gi
gi.require_version("Gtk", "3.0")
for v in ("4.1", "4.0"):
    try:
        gi.require_version("WebKit2", v)
        break
    except ValueError:
        pass
else:
    raise SystemExit(1)
from gi.repository import WebKit2
' 2>/dev/null
}

MISSING=""
LABELS=""
add() { MISSING="$MISSING $1"; LABELS="$LABELS
  - $2"; }
python_ok || add python "Python 3.9 ou mais novo (obrigatório)"
gtk_ok || add gtk "janela nativa: PyGObject + WebKit2GTK (recomendado)"
have secret-tool || add secret "secret-tool, para guardar a chave da Anthropic no chaveiro (recomendado)"
have xdg-open || add xdg "xdg-open, para abrir sites, pastas e arquivos (recomendado)"

if [ -z "$MISSING" ]; then
  echo "Vulcan Terminal: todas as dependências estão instaladas."
  exit 0
fi

# ── gerenciador de pacotes ────────────────────────────────────────────────
PM=""
if have apt-get; then PM=apt; elif have dnf; then PM=dnf; elif have pacman; then PM=pacman; fi

packages() {
  for item in $MISSING; do
    case "$PM:$item" in
      apt:python) echo python3 ;;
      apt:gtk) echo python3-gi ;;          # o WebKit entra no comando com recuo 4.1 -> 4.0
      apt:secret) echo libsecret-tools ;;
      apt:xdg) echo xdg-utils ;;
      dnf:python) echo python3 ;;
      dnf:gtk) echo python3-gobject webkit2gtk4.1 ;;
      dnf:secret) echo libsecret ;;
      dnf:xdg) echo xdg-utils ;;
      pacman:python) echo python ;;
      pacman:gtk) echo python-gobject webkit2gtk-4.1 ;;
      pacman:secret) echo libsecret ;;
      pacman:xdg) echo xdg-utils ;;
    esac
  done | tr '\n' ' ' | sed 's/ *$//'
}

PKGS="$(packages)"
case "$PM" in
  apt)
    WEBKIT=""
    case " $MISSING " in *" gtk "*) WEBKIT="; DEBIAN_FRONTEND=noninteractive apt-get install -y gir1.2-webkit2-4.1 || DEBIAN_FRONTEND=noninteractive apt-get install -y gir1.2-webkit2-4.0" ;; esac
    COMMAND="apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y $PKGS$WEBKIT" ;;
  dnf) COMMAND="dnf install -y $PKGS" ;;
  pacman) COMMAND="pacman -S --needed --noconfirm $PKGS" ;;
  *) COMMAND="" ;;
esac

echo "Vulcan Terminal: faltam dependências:$LABELS"
if [ -z "$COMMAND" ]; then
  echo "Gerenciador de pacotes não reconhecido (suportados: apt, dnf, pacman). Instale os itens acima pelo seu sistema."
  [ "$MODE" = "check" ] && exit 1
  exit 2
fi
echo "Comando: sudo sh -c '$COMMAND'"
[ "$MODE" = "check" ] && exit 1

run_elevated() {
  if [ "$(id -u)" = "0" ]; then
    sh -c "$COMMAND"
  elif have sudo; then
    sudo sh -c "$COMMAND"
  elif have pkexec; then
    pkexec sh -c "$COMMAND"
  else
    echo "Sem sudo ou pkexec: rode o comando acima como administrador." >&2
    return 3
  fi
}

if [ "$MODE" = "ask" ]; then
  # abrir /dev/tty num subshell: falha de redirecionamento num comando embutido encerraria o script
  if [ -t 0 ] || ( : </dev/tty ) 2>/dev/null; then
    printf 'Instalar agora? A senha de administrador pode ser pedida. [s/N] '
    read -r answer </dev/tty 2>/dev/null || answer=""
    case "$answer" in s|S|sim|SIM|y|Y|yes) ;; *) echo "Nada foi instalado."; exit 3 ;; esac
  elif [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && have pkexec && { have zenity || have kdialog; }; then
    question="O Vulcan Terminal precisa instalar:$LABELS

Instalar agora? O sistema vai pedir a senha de administrador."
    if have zenity; then
      zenity --question --title="Vulcan Terminal" --text="$question" --width=460 2>/dev/null || { echo "Nada foi instalado."; exit 3; }
    else
      kdialog --title "Vulcan Terminal" --yesno "$question" 2>/dev/null || { echo "Nada foi instalado."; exit 3; }
    fi
    pkexec sh -c "$COMMAND" || exit 4
    exec sh "$0" --verificar
  else
    echo "Sem terminal para pedir permissão. Rode no terminal: vulcan-terminal --instalar-dependencias"
    exit 3
  fi
fi

run_elevated || exit $?
MODE=check
MISSING=""
python_ok || MISSING="$MISSING python"
gtk_ok || MISSING="$MISSING gtk"
have secret-tool || MISSING="$MISSING secret"
have xdg-open || MISSING="$MISSING xdg"
if [ -n "$MISSING" ]; then
  echo "A instalação terminou, mas ainda falta:$MISSING" >&2
  exit 4
fi
echo "Dependências instaladas."
exit 0
