#!/bin/sh
# Lançador do Vulcan Celox no Linux: usa a biblioteca instalada ao lado deste script.
#   vulcan-terminal --instalar-dependencias   verifica e instala (com sua permissão) as bibliotecas necessárias
#   vulcan-terminal --verificar-dependencias  só verifica
set -e
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in /*) SELF="$LINK" ;; *) SELF="$(dirname "$SELF")/$LINK" ;; esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"
DEPS="$HERE/vulcan-terminal-deps"

case "${1:-}" in
  --instalar-dependencias|--install-deps) shift; exec sh "$DEPS" "$@" ;;
  --verificar-dependencias|--check-deps) exec sh "$DEPS" --verificar ;;
esac

LIB="$(cd "$HERE/../lib" && pwd)"
PYTHON="${VULCAN_PYTHON:-python3}"
python_ok() {
  command -v "$PYTHON" >/dev/null 2>&1 && "$PYTHON" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null
}
if ! python_ok; then
  echo "Vulcan Celox precisa do Python 3.9 ou mais novo." >&2
  # oferece instalar (pergunta no terminal ou por janela); sem permissão, só explica
  sh "$DEPS" || true
  python_ok || { echo "Instale o Python 3.9+ e abra de novo (vulcan-terminal --instalar-dependencias)." >&2; exit 1; }
fi
# com -m, a pasta atual entra no começo do sys.path: roda de dentro da biblioteca para um json.py ou secrets.py
# do repositório onde o usuário está não ser importado no lugar do módulo de verdade
cd "$LIB"
PYTHONPATH="$LIB${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON" -m vulcan_terminal.desktop_linux "$@"
