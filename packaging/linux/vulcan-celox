#!/bin/sh
# Vulcan Celox launcher on Linux: uses the library installed next to this script.
#   vulcan-celox --install-deps   checks and installs (with your permission) the required libraries
#   vulcan-celox --check-deps     only checks
set -e
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in /*) SELF="$LINK" ;; *) SELF="$(dirname "$SELF")/$LINK" ;; esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"
DEPS="$HERE/vulcan-celox-deps"

case "${1:-}" in
  --instalar-dependencias|--install-deps) shift; exec sh "$DEPS" "$@" ;;
  --verificar-dependencias|--check-deps) exec sh "$DEPS" --verificar ;;
esac

LIB="$(cd "$HERE/../lib" && pwd)"
PYTHON="${VULCAN_PYTHON:-python3}"
python_ok() {
  command -v "$PYTHON" >/dev/null 2>&1 && "$PYTHON" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null
}
if ! python_ok; then
  echo "Vulcan Celox needs Python 3.9 or newer." >&2
  # offers to install (asks in the terminal or in a dialog); without permission, only explains
  sh "$DEPS" || true
  python_ok || { echo "Install Python 3.9+ and open it again (vulcan-celox --install-deps)." >&2; exit 1; }
fi
# with -m, the current folder goes to the start of sys.path: runs from inside the library so a json.py or secrets.py
# in the repository where the user is does not get imported in place of the real module
cd "$LIB"
PYTHONPATH="$LIB${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON" -m vulcan_celox.desktop_linux "$@"
