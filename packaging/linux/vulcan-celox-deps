#!/bin/sh
# Checks and installs, with the user's permission, the libraries Vulcan Celox needs on Linux.
#
#   vulcan-celox-deps              checks, shows what is missing and asks before installing
#   vulcan-celox-deps --check      only checks (0 = all good, 1 = something is missing)
#   vulcan-celox-deps -y           installs what is missing without asking (consent given on the command line)
#
# Exit codes: 0 ok or installed, 1 something is missing (--check), 2 unsupported package manager,
# 3 not authorized or no way to ask for permission, 4 the installation failed.
set -u

MODE="ask"
for arg in "$@"; do
  case "$arg" in
    --verificar|--check) MODE="check" ;;
    -y|--sim|--yes) MODE="yes" ;;
    -h|--help|--ajuda) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $arg (use --help)" >&2; exit 2 ;;
  esac
done

have() { command -v "$1" >/dev/null 2>&1; }

python_ok() {
  have python3 && python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null
}
gtk_ok() {
  python_ok && python3 -c '
import gi
gi.require_version("Gtk", "3.0")
for v in ("4.1", "4.0"):
    try:
        gi.require_version("WebKit2", v)
        break
    except ValueError:
        pass
else:
    raise SystemExit(1)
from gi.repository import WebKit2
' 2>/dev/null
}

MISSING=""
LABELS=""
add() { MISSING="$MISSING $1"; LABELS="$LABELS
  - $2"; }
python_ok || add python "Python 3.9 or newer (required)"
gtk_ok || add gtk "native window: PyGObject + WebKit2GTK (recommended)"
have secret-tool || add secret "secret-tool, to keep the Anthropic key in the keyring (recommended)"
have xdg-open || add xdg "xdg-open, to open sites, folders and files (recommended)"

if [ -z "$MISSING" ]; then
  echo "Vulcan Celox: all dependencies are installed."
  exit 0
fi

# ── package manager ────────────────────────────────────────────────
PM=""
if have apt-get; then PM=apt; elif have dnf; then PM=dnf; elif have pacman; then PM=pacman; fi

packages() {
  for item in $MISSING; do
    case "$PM:$item" in
      apt:python) echo python3 ;;
      apt:gtk) echo python3-gi ;;          # WebKit goes into the command with a fallback from 4.1 to 4.0
      apt:secret) echo libsecret-tools ;;
      apt:xdg) echo xdg-utils ;;
      dnf:python) echo python3 ;;
      dnf:gtk) echo python3-gobject webkit2gtk4.1 ;;
      dnf:secret) echo libsecret ;;
      dnf:xdg) echo xdg-utils ;;
      pacman:python) echo python ;;
      pacman:gtk) echo python-gobject webkit2gtk-4.1 ;;
      pacman:secret) echo libsecret ;;
      pacman:xdg) echo xdg-utils ;;
    esac
  done | tr '\n' ' ' | sed 's/ *$//'
}

PKGS="$(packages)"
case "$PM" in
  apt)
    WEBKIT=""
    case " $MISSING " in *" gtk "*) WEBKIT="; DEBIAN_FRONTEND=noninteractive apt-get install -y gir1.2-webkit2-4.1 || DEBIAN_FRONTEND=noninteractive apt-get install -y gir1.2-webkit2-4.0" ;; esac
    COMMAND="apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y $PKGS$WEBKIT" ;;
  dnf) COMMAND="dnf install -y $PKGS" ;;
  pacman) COMMAND="pacman -S --needed --noconfirm $PKGS" ;;
  *) COMMAND="" ;;
esac

echo "Vulcan Celox: missing dependencies:$LABELS"
if [ -z "$COMMAND" ]; then
  echo "Package manager not recognized (supported: apt, dnf, pacman). Install the items above with your system tools."
  [ "$MODE" = "check" ] && exit 1
  exit 2
fi
echo "Command: sudo sh -c '$COMMAND'"
[ "$MODE" = "check" ] && exit 1

run_elevated() {
  if [ "$(id -u)" = "0" ]; then
    sh -c "$COMMAND"
  elif have sudo; then
    sudo sh -c "$COMMAND"
  elif have pkexec; then
    pkexec sh -c "$COMMAND"
  else
    echo "No sudo or pkexec: run the command above as an administrator." >&2
    return 3
  fi
}

if [ "$MODE" = "ask" ]; then
  # open /dev/tty in a subshell: a redirection failure on a builtin would end the script
  if [ -t 0 ] || ( : </dev/tty ) 2>/dev/null; then
    printf 'Install now? The administrator password may be requested. [y/N] '
    read -r answer </dev/tty 2>/dev/null || answer=""
    case "$answer" in s|S|sim|SIM|y|Y|yes) ;; *) echo "Nothing was installed."; exit 3 ;; esac
  elif [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && have pkexec && { have zenity || have kdialog; }; then
    question="Vulcan Celox needs to install:$LABELS

Install now? The system will ask for the administrator password."
    if have zenity; then
      zenity --question --title="Vulcan Celox" --text="$question" --width=460 2>/dev/null || { echo "Nothing was installed."; exit 3; }
    else
      kdialog --title "Vulcan Celox" --yesno "$question" 2>/dev/null || { echo "Nothing was installed."; exit 3; }
    fi
    pkexec sh -c "$COMMAND" || exit 4
    exec sh "$0" --check
  else
    echo "No terminal to ask for permission. Run in a terminal: vulcan-celox --install-deps"
    exit 3
  fi
fi

run_elevated || exit $?
MODE=check
MISSING=""
python_ok || MISSING="$MISSING python"
gtk_ok || MISSING="$MISSING gtk"
have secret-tool || MISSING="$MISSING secret"
have xdg-open || MISSING="$MISSING xdg"
if [ -n "$MISSING" ]; then
  echo "The installation finished, but this is still missing:$MISSING" >&2
  exit 4
fi
echo "Dependencies installed."
exit 0
