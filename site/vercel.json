{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/prompts/arquivos/:file(.*\\.md)",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pt-br/",
      "destination": "https://celox.byvulcan.com/",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "vulcan-celox.vercel.app"
        }
      ],
      "destination": "https://celox.byvulcan.com/:path",
      "permanent": true
    },
    {
      "source": "/downloads/Vulcan-Celox-1.4.0-macos-universal.zip",
      "destination": "https://github.com/freddominugez/vulcan-celox/releases/download/v1.4.0/Vulcan-Celox-1.4.0-macos.zip",
      "permanent": false
    }
  ]
}
