#!/bin/sh
# fake lerd for the sensor: only the outputs the screens read; the rest does nothing
case "$1 $2" in
  "php:list "*) printf 'Installed PHP versions:\n  8.4\n* 8.5\n' ;;
  "xdebug status") printf 'Version  Xdebug    Mode\n8.4      disabled  \n8.5      enabled   debug,coverage\n' ;;
  "--version "*|"version "*) echo "lerd version 1.37.1" ;;
esac
exit 0
